APP_ENV=development
DATABASE_URL=postgresql://proofpath_codex_app@127.0.0.1:5432/proofpath_codex_dev
PROOFPATH_PUBLIC_URL=http://127.0.0.1:8000
PROOFPATH_TERMS_VERSION=
PROOFPATH_TERMS_URL=
# Production requires the same random secret (at least 32 bytes) on every API worker.
PROOFPATH_RATE_LIMIT_SECRET=
# Optional SMTP settings. Development falls back to the local ignored mailbox file.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
